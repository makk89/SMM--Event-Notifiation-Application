# ── SMTP Email Settings ──────────────────────────────────────────────────────
# Fill in your Office 365 / Exchange SMTP credentials to enable email notifications.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@scorpiogroup.net
SMTP_PASS=your-email-password

# ── Microsoft Teams Webhook ───────────────────────────────────────────────────
# Paste your Teams Incoming Webhook URL here to enable Teams notifications.
# In Teams: channel → Manage channel → Connectors → Incoming Webhook → Configure
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/YOUR_WEBHOOK_URL_HERE
